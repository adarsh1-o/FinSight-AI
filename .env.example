# Grounded AI assistant provider: gemini or openai (default: openai).
FINSIGHT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# For OpenAI, use FINSIGHT_LLM_API_KEY or OPENAI_API_KEY instead.
# OPENAI_API_KEY=
# FINSIGHT_LLM_API_KEY=
# Defaults: gemini-3.8-flash for Gemini, gpt-4o-mini for OpenAI.
# FINSIGHT_LLM_MODEL=gemini-3.8-flash
# Optional custom OpenAI-compatible chat completions URL.
# FINSIGHT_LLM_BASE_URL=

# Local documentation retrieval settings (no external embedding service required).
FINSIGHT_RAG_CHUNK_SIZE=1200
FINSIGHT_RAG_CHUNK_OVERLAP=150
FINSIGHT_RAG_EMBEDDING_DIMENSIONS=16384
FINSIGHT_RAG_TOP_K=4
# FINSIGHT_RAG_DB_PATH=data/processed/finsight_documents.sqlite3
