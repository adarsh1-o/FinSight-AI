# Stage 06B grounded AI assistant configuration
# Required to generate natural-language answers.
FINSIGHT_LLM_API_KEY=

# Optional OpenAI-compatible provider settings.
FINSIGHT_LLM_MODEL=gpt-4o-mini
FINSIGHT_LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# OPENAI_API_KEY is also accepted for standard OpenAI environments.
# OPENAI_API_KEY=

# Local documentation retrieval settings (no external embedding service required).
FINSIGHT_RAG_CHUNK_SIZE=1200
FINSIGHT_RAG_CHUNK_OVERLAP=150
FINSIGHT_RAG_EMBEDDING_DIMENSIONS=16384
FINSIGHT_RAG_TOP_K=4
# FINSIGHT_RAG_DB_PATH=data/processed/finsight_documents.sqlite3
